# Pacotes do AUR. NÃO entram no pacstrap dos repositórios: o iso/build os
# compila num repositório local (mk-aur) que vai no ISO, e a falha de um não
# trava nem o build nem a instalação (o que faltar fica para o yay depois).
# Regra: só vem para cá o que não existe em core/extra.
# Use o nome do PackageBase do AUR.

# Helper do AUR (instalado primeiro, para compilar o resto)
yay-bin

# Hooks do limine: regeneram o menu de boot e adicionam o submenu de snapshots
limine-mkinitcpio-hook
limine-snapper-sync

# Firewall que o Docker não fura (o Docker escreve no iptables por fora do ufw)
ufw-docker

# Compartilhamento de arquivos na rede local, estilo AirDrop
localsend-bin

# Fraunces: a serifa do perfil codexmark (marca Mk, letras dos workspaces,
# títulos). Só existe no AUR; sem ela o Maré usa a Noto Serif.
ttf-fraunces-variable

# ble.sh: no terminal do Mk, sugestões em cinza enquanto digita (Tab completa)
# e cores de sintaxe. Só existe no AUR. A versão -git é a 0.4, que tem as
# cores por tipo que o Mk usa; o pacote "blesh" ainda é o 0.3.
blesh-git
# Vercel CLI. Só existe no AUR; atualiza com o `mk atualizar` (yay).
vercel
