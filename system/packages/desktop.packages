# Sessão gráfica: Hyprland e as peças em volta dele.
# A barra, o launcher e as notificações são do Maré (quickshell): não há
# waybar, fuzzel nem mako aqui.

# Compositor e sessão
hyprland
# uwsm: inicia o Hyprland como sessão systemd (mesmo esquema do Omarchy)
uwsm
xdg-desktop-portal-hyprland
xdg-desktop-portal-gtk
hyprpolkitagent
xorg-xwayland
qt6-wayland
qt5-wayland
xdg-user-dirs
xdg-utils

# Login
sddm

# Ociosidade, bloqueio de tela, luz noturna, conta-gotas
# (o papel de parede é desenhado pelo próprio Maré)
hypridle
hyprlock
hyprsunset
hyprpicker

# Shell: a linha do Maré (shell/mare) roda no Quickshell. Ela também é o
# launcher e o servidor de notificações, então não há mako nem fuzzel.
quickshell
# cava: o espectro do som, para a ilha ondular com a música
cava
# qt6-imageformats: o Maré abre papéis de parede em WebP, AVIF e TIFF
qt6-imageformats
# qt6-multimedia: o MkCorte (apps/mkcorte) mostra o vídeo que está sendo
# cortado; o -ffmpeg é quem decodifica
qt6-multimedia
qt6-multimedia-ffmpeg
libnotify

# MkTunes, o player de música do Mk (apps/mktunes): o daemon vai pronto (um
# binário em Go), o som sai pelo mpv, o áudio do YouTube é achado pelo yt-dlp,
# as tags das músicas do computador vêm do ffprobe e o sqlite3 leva a
# biblioteca da versão antiga para a nova. mpv, ffmpeg e yt-dlp também estão em
# apps.packages; aqui é porque o MkTunes não é opcional
yt-dlp
sqlite
mpv
ffmpeg

# Captura de tela, área de transferência e mídia
grim
slurp
wl-clipboard
# wl-clip-persist: o que foi copiado sobrevive ao fechar o app de origem
wl-clip-persist
# wtype: o painel de emoji digita o escolhido na janela em foco
wtype
# playerctl: teclas play/pause/próxima para qualquer player
playerctl
# cliphist: histórico da área de transferência (Super+Shift+V)
cliphist
# matugen: tira a cor principal do papel de parede para tingir o Maré
matugen
# qrencode: QR code para o celular entrar no Wi-Fi (painel de rede)
qrencode
gpu-screen-recorder
# tesseract e zbar: o "ler" da captura (texto e QR code de uma área da tela)
tesseract
tesseract-data-por
tesseract-data-eng
zbar

# Tema
gnome-themes-extra
papirus-icon-theme
# adw-gtk-theme: a base do tema GTK do Mk (GTK 3 igual ao libadwaita)
adw-gtk-theme
qt6ct
gnome-keyring
# gcr-4: o agente SSH do chaveiro (gcr-ssh-agent), ligado para todos os usuários
gcr-4
polkit
