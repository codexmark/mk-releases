#!/usr/bin/env bash
# Faz o menu de boot (limine) iniciar sozinho depois da contagem.
#
# O limine inicia a entrada 1 por padrão. Com os ganchos do limine
# (limine-mkinitcpio-hook, limine-snapper-sync) o menu é reescrito: "Mk" vira
# um grupo com "linux" e "Snapshots" dentro, e um grupo só abre e fecha. A
# contagem acabava e nada iniciava.
#
# O que este script faz: acha a primeira entrada que inicia de verdade (tem
# "protocol:" e não tem filhos), abre os grupos acima dela ("/Mk" vira "/+Mk",
# que o limine mostra já aberto) e grava em default_entry a posição dela
# entre as entradas visíveis. O limine só conta o que está visível: com o
# grupo fechado, a entrada 2 seria a de baixo ("EFI fallback"), não o linux.
#
# Roda como root; pode rodar quantas vezes quiser.
#   limine-default [arquivo]     (padrão: o limine.conf de /boot)
set -euo pipefail

conf=${1:-}
if [[ -z $conf ]]; then
  for c in /boot/limine.conf /boot/EFI/limine/limine.conf /boot/limine/limine.conf; do
    [[ -f $c ]] && conf=$c && break
  done
fi
[[ -n $conf && -f $conf ]] || { echo "limine-default: limine.conf não encontrado"; exit 0; }

# As entradas: linha, profundidade (quantas barras), se já está aberta ("+")
# e se tem "protocol:".
lines=() depths=() opens=() protos=()
n=0
lineno=0
while IFS= read -r line || [[ -n $line ]]; do
  lineno=$((lineno + 1))
  trimmed=${line#"${line%%[![:space:]]*}"}
  if [[ $trimmed == /* ]]; then
    slashes=${trimmed%%[!/]*}
    n=$((n + 1))
    lines[n]=$lineno
    depths[n]=${#slashes}
    rest=${trimmed#"$slashes"}
    if [[ $rest == +* ]]; then opens[n]=1; else opens[n]=0; fi
    protos[n]=0
  elif [[ $trimmed == protocol:* && $n -gt 0 ]]; then
    protos[n]=1
  fi
done <"$conf"

# A primeira que inicia: tem protocol e a próxima não é filha dela.
target=0
for ((i = 1; i <= n; i++)); do
  if ((protos[i])) && ! ((i < n && depths[i + 1] > depths[i])); then
    target=$i
    break
  fi
done
((target > 0)) || { echo "limine-default: nenhuma entrada que inicie em $conf"; exit 0; }

# Abre os grupos acima dela.
changed=0
need=$((depths[target] - 1))
for ((i = target - 1; i >= 1 && need >= 1; i--)); do
  if ((depths[i] == need)); then
    if ! ((opens[i])); then
      sed -i -E "${lines[i]}s|^([[:space:]]*/+)|\\1+|" "$conf"
      opens[i]=1
      changed=1
    fi
    need=$((need - 1))
  fi
done

# A posição dela entre as visíveis (filhos de grupo fechado não contam).
want=0
hidden_below=0 # profundidade do grupo fechado que esconde as próximas
for ((i = 1; i <= target; i++)); do
  if ((hidden_below > 0 && depths[i] > hidden_below)); then
    continue
  fi
  hidden_below=0
  want=$((want + 1))
  # Um grupo (tem filhos) fechado esconde o que vem dentro.
  if ((i < n && depths[i + 1] > depths[i])) && ! ((opens[i])); then
    hidden_below=${depths[i]}
  fi
done

have=$(awk -F': *' '/^default_entry:/ { print $2; exit }' "$conf")
if [[ $have != "$want" ]]; then
  if [[ -n $have ]]; then
    sed -i "s/^default_entry:.*/default_entry: $want/" "$conf"
  elif grep -q '^timeout:' "$conf"; then
    sed -i "/^timeout:/a default_entry: $want" "$conf"
  else
    sed -i "1i default_entry: $want" "$conf"
  fi
  changed=1
fi

if ((changed)); then
  echo "limine-default: inicia sozinho pela entrada $want de $conf"
  # Com a verificação ligada, o limine confere o resumo do limine.conf.
  if command -v limine-enroll-config >/dev/null; then
    limine-enroll-config >/dev/null 2>&1 || true
  fi
else
  echo "limine-default: já está certo (entrada $want)"
fi
