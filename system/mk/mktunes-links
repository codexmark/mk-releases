#!/usr/bin/env bash
# Liga o MkTunes (apps/mktunes) ao sistema: o comando mktunes, o atalho no menu
# e o ícone. São links para /usr/share/mk, então a versão que o mk-update traz
# vale sozinha, sem rodar isto de novo.
#   mktunes-links [raiz]   o instalador passa a raiz do sistema novo
set -euo pipefail
root=${1:-/}
root=${root%/}
app=/usr/share/mk/apps/mktunes

link() {
  mkdir -p "$root$(dirname "$2")"
  ln -sfn "$app/$1" "$root$2"
}
link bin/mktunes /usr/bin/mktunes
link share/mktunes.desktop /usr/share/applications/mktunes.desktop
link share/mktunes.svg /usr/share/icons/hicolor/scalable/apps/mktunes.svg

# No sistema em uso, o menu e os ícones percebem já.
if [[ -z $root ]]; then
  update-desktop-database -q /usr/share/applications 2>/dev/null || true
  gtk-update-icon-cache -qtf /usr/share/icons/hicolor 2>/dev/null || true
fi
