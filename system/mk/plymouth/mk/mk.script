# Boot do Mk. Fundo #0b0b0b, o Mk no centro, embaixo dele uma linha fina em
# osso onde a cópia em cobre avança com o boot. Com o disco criptografado, a
# senha é pedida no mesmo lugar, com pontos no lugar das letras.

Window.SetBackgroundTopColor(0.043, 0.043, 0.043);
Window.SetBackgroundBottomColor(0.043, 0.043, 0.043);

W = Window.GetWidth();
H = Window.GetHeight();

mark.image = Image("mark.png");
scale = (H / 1080) * 0.55;
if (scale < 0.35) scale = 0.35;
mark.image = mark.image.Scale(mark.image.GetWidth() * scale, mark.image.GetHeight() * scale);
mark.sprite = Sprite(mark.image);
mark.x = W / 2 - mark.image.GetWidth() / 2;
mark.y = H / 2 - mark.image.GetHeight();
mark.sprite.SetPosition(mark.x, mark.y, 2);
mark.sprite.SetOpacity(0);

bar.width = W * 0.14;
bar.x = W / 2 - bar.width / 2;
bar.y = H / 2 + H * 0.05;
track.image = Image("track.png").Scale(bar.width, 1);
track.sprite = Sprite(track.image);
track.sprite.SetPosition(bar.x, bar.y, 1);
track.sprite.SetOpacity(0);
fill.base = Image("fill.png");
fill.sprite = Sprite();
fill.sprite.SetPosition(bar.x, bar.y, 2);

# Entra devagar: o Mk e a linha aparecem nos primeiros instantes.
fade = 0;
shown = 0;
fun refresh_callback() {
    if (fade < 1) {
        fade += 0.04;
        if (fade > 1) fade = 1;
        mark.sprite.SetOpacity(fade);
        track.sprite.SetOpacity(fade);
    }
}
Plymouth.SetRefreshFunction(refresh_callback);

fun progress_callback(duration, progress) {
    if (progress > shown) shown = progress;
    w = Math.Int(bar.width * shown);
    if (w < 1) w = 1;
    fill.sprite.SetImage(fill.base.Scale(w, 1));
}
Plymouth.SetBootProgressFunction(progress_callback);

# Senha do disco (LUKS).
prompt.sprite = Sprite();
bullets = [];
fun display_password_callback(prompt_text, count) {
    label = Image.Text("senha do disco", 0.8, 0.77, 0.73, 1, "Space Mono 11");
    prompt.sprite.SetImage(label);
    prompt.sprite.SetPosition(W / 2 - label.GetWidth() / 2, bar.y + 28, 3);
    prompt.sprite.SetOpacity(1);
    for (i = 0; bullets[i]; i++) bullets[i].SetOpacity(0);
    dot = Image("bullet.png");
    total = count * 16;
    for (i = 0; i < count && i < 40; i++) {
        bullets[i] = Sprite(dot);
        bullets[i].SetPosition(W / 2 - total / 2 + i * 16, bar.y + 60, 3);
    }
    fill.sprite.SetOpacity(0);
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_normal_callback() {
    prompt.sprite.SetOpacity(0);
    for (i = 0; bullets[i]; i++) bullets[i].SetOpacity(0);
    fill.sprite.SetOpacity(1);
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);

# Mensagens (ex.: "verificando o disco") aparecem pequenas, embaixo.
message.sprite = Sprite();
fun message_callback(text) {
    img = Image.Text(text, 0.44, 0.42, 0.41, 1, "Space Mono 10");
    message.sprite.SetImage(img);
    message.sprite.SetPosition(W / 2 - img.GetWidth() / 2, H - 60, 3);
}
Plymouth.SetMessageFunction(message_callback);

fun quit_callback() {
    fill.sprite.SetImage(fill.base.Scale(bar.width, 1));
}
Plymouth.SetQuitFunction(quit_callback);
