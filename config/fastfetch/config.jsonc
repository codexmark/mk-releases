// A ficha do Mk no terminal: o desenho à esquerda, os dados como o carimbo de
// uma folha técnica à direita. Cores da linha Folha: osso, cobre e cinzas.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "~/.config/mk/fastfetch/emblem.png",
    "width": 32,
    "height": 16,
    "padding": { "top": 1, "left": 2, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "38;2;113;107;105", "title": "38;2;205;196;186", "output": "38;2;205;196;186" },
    "key": { "width": 14 },
    "bar": { "char": { "elapsed": "━", "total": "─" }, "width": 12 },
    "percent": { "type": 3, "color": { "green": "38;2;176;169;160", "yellow": "38;2;206;94;50", "red": "38;2;206;94;50" } }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "{#38;2;206;94;50}01{#}  {#1;38;2;205;196;186}{user-name}{#}{#38;2;113;107;105} @ {#}{#38;2;205;196;186}{host-name}{#}"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;149;143;135m    um desktop Arch, pronto para trabalhar\u001b[0m"
    },
    "break",
    { "type": "custom", "format": "\u001b[38;2;206;94;50m──\u001b[0m \u001b[38;2;113;107;105mSISTEMA ─────────────────────────\u001b[0m" },
    { "type": "os", "key": "sistema", "format": "{pretty-name} · {arch}" },
    { "type": "kernel", "key": "kernel" },
    { "type": "wm", "key": "janelas", "format": "{pretty-name} {version}" },
    { "type": "shell", "key": "shell" },
    { "type": "packages", "key": "pacotes", "format": "{all}" },
    { "type": "uptime", "key": "ligado há", "format": "{?days}{days} d {?}{hours} h {minutes} min" },
    "break",
    { "type": "custom", "format": "\u001b[38;2;206;94;50m──\u001b[0m \u001b[38;2;113;107;105mMÁQUINA ─────────────────────────\u001b[0m" },
    { "type": "host", "key": "modelo" },
    { "type": "cpu", "key": "processador", "format": "{name}" },
    { "type": "gpu", "key": "vídeo", "format": "{name}", "detectionMethod": "pci" },
    { "type": "memory", "key": "memória" },
    { "type": "disk", "key": "disco", "folders": "/" },
    { "type": "battery", "key": "bateria", "format": "{capacity-bar} {capacity}" },
    "break",
    { "type": "custom", "format": "\u001b[38;2;113;107;105m    super  busca · super + ,  ajustes\u001b[0m" }
  ]
}
