// A ficha do Mk no terminal, compacta: a marca pequena à esquerda e, ao lado,
// o carimbo da folha (quem, onde, a data) e três seções curtas. No fim, a
// paleta Folha: a escala de osso e o cobre.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "~/.config/mk/fastfetch/mark.png",
    "width": 15,
    "height": 5,
    "padding": { "top": 2, "left": 2, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "38;2;206;94;50", "title": "1;38;2;205;196;186", "output": "38;2;205;196;186" },
    "key": { "width": 11 },
    "percent": { "type": 1, "color": { "green": "38;2;176;169;160", "yellow": "38;2;206;94;50", "red": "1;38;2;206;94;50" } }
  },
  "modules": [
    "break",
    // Quem e onde. Linha própria em vez do módulo "title", que some quando
    // a imagem (kitty) está ligada em algumas versões do fastfetch.
    {
      "type": "command",
      "key": " ",
      "keyWidth": 1,
      "text": "printf '%s @ %s' \"$USER\" \"$(cat /etc/hostname 2>/dev/null || uname -n)\"",
      "format": "\u001b[1;38;2;205;196;186m{}\u001b[0m"
    },
    {
      "type": "command",
      "key": " ",
      "keyWidth": 1,
      "text": "date +%d.%m.%Y",
      "format": "\u001b[38;2;206;94;50m■\u001b[0m \u001b[38;2;149;143;135mMK · folha {} · um desktop Arch, pronto para trabalhar\u001b[0m"
    },
    "break",
    { "type": "custom", "format": "\u001b[38;2;206;94;50m──\u001b[0m \u001b[1;38;2;205;196;186mMÁQUINA\u001b[0m \u001b[38;2;58;54;50m──────────────────────────\u001b[0m" },
    { "type": "cpu", "key": "CPU", "format": "{name} ({cores-logical})" },
    { "type": "gpu", "key": "VÍDEO", "format": "{name}", "detectionMethod": "pci" },
    { "type": "memory", "key": "MEMÓRIA", "format": "{used} / {total} ({percentage})" },
    { "type": "disk", "key": "DISCO", "folders": "/", "format": "{size-used} / {size-total} ({size-percentage})" },
    "break",
    { "type": "custom", "format": "\u001b[38;2;206;94;50m──\u001b[0m \u001b[1;38;2;205;196;186mSISTEMA\u001b[0m \u001b[38;2;58;54;50m──────────────────────────\u001b[0m" },
    { "type": "os", "key": "SISTEMA", "format": "{pretty-name} {arch}" },
    { "type": "kernel", "key": "KERNEL" },
    { "type": "wm", "key": "JANELAS", "format": "{pretty-name} {version}" },
    { "type": "packages", "key": "PACOTES", "format": "{all}" },
    "break",
    { "type": "custom", "format": "\u001b[38;2;206;94;50m──\u001b[0m \u001b[1;38;2;205;196;186mSESSÃO\u001b[0m \u001b[38;2;58;54;50m───────────────────────────\u001b[0m" },
    { "type": "uptime", "key": "LIGADO", "format": "{?days}{days} d {?}{hours} h {minutes} min" },
    { "type": "terminal", "key": "TERMINAL", "format": "{pretty-name}" },
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;113;107;105m●\u001b[0m \u001b[38;2;128;122;115m●\u001b[0m \u001b[38;2;149;143;135m●\u001b[0m \u001b[38;2;176;169;160m●\u001b[0m \u001b[38;2;205;196;186m●\u001b[0m   \u001b[38;2;206;94;50m●\u001b[0m"
    }
  ]
}
