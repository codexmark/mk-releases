#!/usr/bin/env bash
# Atualiza o Mk inteiro, num terminal: o próprio Mk (pelo canal git, se houver
# um), os pacotes do Arch e os do AUR. Os Ajustes abrem isto em "Atualizações".
#
#   mk-update           atualiza tudo, perguntando antes
#   mk-update --check   só mostra o que há (o mesmo que os Ajustes mostram)
#
# Uma confirmação só: depois do "Atualizar agora?", o pacman e o yay rodam sem
# perguntar (--noconfirm). O que é decisão sua e não confirmação (tirar a trava
# do pacman, os apps novos, o AUR que ficou de fora) é perguntado em seguida,
# tudo antes da parte demorada: dá para responder e sair de perto. O que o
# pacman não pode decidir sozinho (escolher um provedor, remover um pacote em
# conflito) para a rodada com o aviso, em vez de escolher por você.
#
# Uma rodada de cada vez: a segunda sai com "já há uma atualização rodando"
# (flock em $XDG_RUNTIME_DIR/mk-update.trava). O --check não entra nisso.
#
# Ordem: o próprio Mk, as migrações (migrations/: mudanças fora de
# ~/.config/mk, cada uma roda uma vez), o Arch e o AUR. Depois de trocar o Mk,
# o mk-update passa a vez para a versão nova dele mesmo (--after-mk), para
# que a lógica nova já valha nesta rodada.
#
# Migração não instala pacote: ela roda antes do -Syu, com a lista de pacotes
# velha, e um download que falha travaria toda atualização seguinte. A que
# precisa de pacote declara numa linha "# pacotes: a b c"; eles entram na
# transação do -Syu e a migração roda depois dela, tolerando a falta deles.
#
# Registro: a saída inteira fica em ~/.local/state/mk/atualizacao-*.log (os 5
# últimos) e o resumo da rodada em ultima-atualizacao.json, que os Ajustes
# leem (scripts/mare-updates).
#
# Snapshots: com o snap-pac, cada pacman cria um snapshot antes e depois, e o
# limine lista os snapshots no boot. Se algo quebrar, dá para voltar.
#
# Para testar sem tocar na máquina: MK_ROOT=<pasta> troca a raiz de tudo que é
# lido e escrito em /usr, /var e /etc (o mesmo MK_ROOT do scripts/mare-updates);
# MK_SHARE troca só o /usr/share/mk. Os comandos (sudo, pacman, yay, git,
# pgrep, uname, hyprctl, flock) vêm do PATH. MK_UPDATE_SUDO_CADA troca o
# intervalo (segundos) em que a senha do sudo é renovada.
set -euo pipefail

root=${MK_ROOT:-}
share=${MK_SHARE:-$root/usr/share/mk}
cfg=${XDG_CONFIG_HOME:-$HOME/.config}/mk
marker=.instalado-pelo-mk
check=$share/shell/mare/scripts/mare-updates
[[ -x $check ]] || check=$cfg/shell/scripts/mare-updates
mode=${1:-}
sys_done=$root/var/lib/mk/migrations
state=${XDG_STATE_HOME:-$HOME/.local/state}/mk
user_done=$state/migrations
summary=$state/ultima-atualizacao.json

# Roda de novo dentro do script(1), que grava tudo o que o terminal mostra:
# continua sendo um terminal de verdade (senha do sudo, perguntas e barras do
# pacman iguais), e a senha, que não aparece na tela, não vai para o registro.
# A troca para o mk-update novo (--after-mk) herda MK_UPDATE_LOG e segue no
# mesmo registro.
if [[ -z ${MK_UPDATE_LOG:-} && $mode != --check && -t 0 && -t 1 ]] && command -v script >/dev/null; then
  mkdir -p "$state"
  log=$state/atualizacao-$(date +%Y%m%d-%H%M%S).log
  rc=0 spid=""
  # Janela fechada no meio: o script(1) não vê o HUP e ficaria para sempre. Ele
  # roda ao fundo (o env devolve o Ctrl-C que o bash tira de quem roda assim) e
  # o HUP é repassado à rodada, como o terminal faria; depois arruma o registro.
  trap 'p=$(pgrep -P "$spid" | head -1) && kill -HUP -- "-${p:-x}" 2>/dev/null || true' HUP TERM
  MK_UPDATE_LOG=$log script -qefc "$(printf '%q ' env --default-signal=INT,QUIT bash "$0" "$@")" "$log" <&0 &
  spid=$!
  while :; do
    wait "$spid" && rc=0 || rc=$?
    kill -0 "$spid" 2>/dev/null || break
  done
  trap '' HUP TERM
  if [[ -r $summary && $(jq -r '.log // ""' "$summary" 2>/dev/null) == "$log" ]]; then
    # Limpa para ler depois: fica o fim de cada barra de progresso e as cores.
    sed -i -e '1{/\[COMMAND=/d}' -e '${/\[COMMAND_EXIT_CODE=/d}' -e 's/\r*$//' -e 's/.*\r//' \
      -e 's/\x1b\[[0-9;?]*[A-Za-ln-z]//g' -e 's/\x1b\][^\x07\x1b]*\(\x07\|\x1b\\\)//g' "$log" || true
  else
    # Nada foi aplicado (tudo em dia, ou você disse não): sem registro.
    rm -f "$log"
  fi
  logs=("$state"/atualizacao-*.log)
  ((${#logs[@]} > 5)) && rm -f "${logs[@]:0:${#logs[@]}-5}"
  exit "$rc"
fi

copper=$'\e[38;2;206;94;50m' bone=$'\e[38;2;205;196;186m' dim=$'\e[38;2;113;107;105m' off=$'\e[0m'
say() { printf '\n%s──%s %s%s%s\n' "$copper" "$off" "$bone" "$*" "$off"; }
note() { printf '%s%s%s\n' "$dim" "$*" "$off"; }
ask() {
  local reply
  # Sem resposta (janela fechada) é não.
  read -rp "$1 [S/n] " reply || return 1
  [[ -z $reply || $reply == [sSyY]* ]]
}
closed=0
pause() {
  [[ -t 0 ]] && ((!closed)) || return 0
  echo
  read -rsp "${dim}Enter fecha.${off}" _ || true
  echo
}

# Uma rodada de cada vez: duas ao mesmo tempo trocariam o /usr/share/mk uma por
# cima da outra e disputariam o pacman. Roda de novo dentro do flock(1), que
# segura a trava enquanto a rodada existir e a solta quando ela acaba ou morre:
# o arquivo fica, mas a trava é do processo, e não há o que destravar à mão. O
# -o não passa a trava adiante, senão um
# processo que a rodada deixasse para trás (o gpg-agent que o yay sobe) ficaria
# com ela. A versão nova que assume depois da troca do Mk (--after-mk) herda
# MK_UPDATE_TRAVADO e segue na mesma trava. O --check não trava nem é travado.
trava=${XDG_RUNTIME_DIR:-$state}/mk-update.trava
ocupado=219 # o que o flock devolve quando a trava é de outro
if [[ -z ${MK_UPDATE_TRAVADO:-} && $mode != --check ]] && command -v flock >/dev/null; then
  mkdir -p "${trava%/*}"
  rc=0
  MK_UPDATE_TRAVADO=1 flock -n -o -E "$ocupado" "$trava" bash "$0" "$@" || rc=$?
  if ((rc == ocupado)); then
    say "já há uma atualização rodando"
    note "Espere ela terminar (ou feche a janela dela) e rode de novo."
    rc=1
  fi
  # Janela fechada no meio (HUP, TERM): não há a quem pedir o Enter.
  ((rc == 129 || rc == 143)) || pause
  exit "$rc"
fi

# A versão do Mk instalada (o commit, 12 letras).
mk_version() {
  local f v=""
  for f in "$cfg/VERSION" "$share/VERSION"; do
    # Um arquivo vazio (desligamento à força logo depois de atualizar) não
    # é uma versão: vale o seguinte.
    if [[ -r $f ]]; then
      read -r v _ <"$f" || true
      [[ -n $v ]] && break
    fi
  done
  printf '%s' "${v:0:12}"
}

# O resumo da rodada, para os Ajustes: quando, se deu certo, em que passo
# parou, se o kernel pede reinício e a versão do Mk antes e depois. `applied`
# é a última vez que tudo deu certo (a ilha conta a semana a partir dela).
applying=0 step=""
# Depois da troca do Mk, a rodada já está em curso.
if [[ $mode == --after-mk ]]; then applying=1 step=mk; fi
export MK_UPDATE_START=${MK_UPDATE_START:-$(date +%s)}
[[ -v MK_UPDATE_FROM ]] || MK_UPDATE_FROM=$(mk_version)
export MK_UPDATE_FROM
write_summary() {
  local rc=$1 now ok=false reboot=false applied=0
  now=$(date +%s)
  [[ -r $summary ]] && applied=$(jq -r '.applied // 0 | floor' "$summary" 2>/dev/null) || applied=0
  [[ $applied =~ ^[0-9]+$ ]] || applied=0
  if ((rc == 0)); then
    ok=true applied=$now step=""
  fi
  [[ -d $root/usr/lib/modules/$(uname -r) ]] || reboot=true
  mkdir -p "$state"
  jq -nc --argjson when "$now" --argjson started "$MK_UPDATE_START" --argjson ok "$ok" \
    --arg step "$step" --argjson reboot "$reboot" --argjson applied "$applied" \
    --arg from "$MK_UPDATE_FROM" --arg to "$(mk_version)" --arg log "${MK_UPDATE_LOG:-}" \
    '{when: $when, started: $started, ok: $ok, step: $step, reboot: $reboot,
      applied: $applied, from: $from, to: $to, log: $log}' >"$summary.novo" &&
    mv "$summary.novo" "$summary"
}

# Migrações que ainda não rodaram aqui: "system/nome.sh" e "user/nome.sh".
pending_migrations() {
  local f kind
  for kind in system user; do
    for f in "$share/migrations/$kind"/*.sh; do
      [[ -f $f ]] || continue
      if [[ $kind == system ]]; then
        [[ -e $sys_done/$(basename "$f") ]] || echo "$kind/$(basename "$f")"
      else
        [[ -e $user_done/$(basename "$f") ]] || echo "$kind/$(basename "$f")"
      fi
    done
  done
}

# Os pacotes que uma migração declara precisar (a linha "# pacotes: a b c").
migration_packages() {
  sed -n 's/^# pacotes:[[:space:]]*//p' "$1" | tr -s '[:space:]' '\n' |
    grep -E '^[a-z0-9@._+-]+$' || true
}

run_migration() {
  note "  $1"
  if [[ $1 == system/* ]]; then
    sudo env MK_SHARE="$share" bash "$share/migrations/$1"
    sudo mkdir -p "$sys_done"
    sudo touch "$sys_done/$(basename "$1")"
  else
    MK_SHARE="$share" bash "$share/migrations/$1"
    mkdir -p "$user_done"
    touch "$user_done/$(basename "$1")"
  fi
}

# O sudo esquece a senha em poucos minutos e a transação pode levar mais que
# isso: o passo seguinte (anotar os apps, uma migração, o yay na hora de
# instalar) pararia no meio pedindo a senha de novo, sem ninguém por perto.
# Pede a senha uma vez, antes da parte demorada, e renova ao fundo enquanto a
# rodada durar. Se o sudo não deixa renovar, o laço desiste em silêncio.
sudo_pid=""
segura_sudo() {
  [[ -z $sudo_pid ]] || return 0
  sudo -v
  local eu=$$
  (
    exec </dev/null >/dev/null 2>&1
    # O sleep fica ao fundo para o TERM do finish ser atendido na hora, sem
    # deixar um sleep órfão.
    trap 'kill "$dorme" 2>/dev/null; exit 0' TERM
    while kill -0 "$eu" 2>/dev/null; do
      sleep "${MK_UPDATE_SUDO_CADA:-50}" &
      dorme=$!
      wait "$dorme" || exit 0
      sudo -n -v || exit 0
    done
  ) &
  sudo_pid=$!
}

# Qualquer saída (erro, janela fechada) passa por aqui: para de renovar o sudo,
# apaga a pasta do clone, se sobrou, e grava o resumo.
tmp=""
finish() {
  local rc=$?
  if [[ -n $sudo_pid ]]; then kill "$sudo_pid" 2>/dev/null || true; fi
  if [[ -n $tmp && -d $tmp ]]; then rm -rf "${tmp:?}" || true; fi
  ((applying)) && { write_summary "$rc" || true; }
  # Com a trava, quem espera o Enter é quem a segura (lá em cima), já solta.
  [[ -n ${MK_UPDATE_TRAVADO:-} ]] || pause
}
trap finish EXIT
# Terminal fechado no meio também deixa o resumo ("parou em").
trap 'closed=1; exit 129' HUP
trap 'closed=1; exit 143' TERM

printf '\n  %sM%s%sk%s  %satualizações%s\n' "$bone" "$off" "$copper" "$off" "$dim" "$off"

say "procurando"
info=$(bash "$check")
nsys=$(jq '.system | length' <<<"$info")
naur=$(jq '.aur | length' <<<"$info")
mk_available=$(jq -r '.mk.available' <<<"$info")
channel=$(jq -r '.mk.channel' <<<"$info")
error=$(jq -r '.error' <<<"$info")
[[ -n $error ]] && note "aviso: $error"

printf '  Mk         %s\n' "$(jq -r 'if .mk.available then "nova versão (\(.mk.latest))"
  elif .mk.channel == "" then "sem canal de atualização" else "em dia (\(.mk.version))" end' <<<"$info")"
printf '  sistema    %s pacotes\n' "$nsys"
printf '  AUR        %s pacotes\n' "$naur"
mapfile -t pend < <(pending_migrations)
((${#pend[@]})) && printf '  ajustes    %s mudanças do Mk no sistema\n' "${#pend[@]}"
# As migrações que pedem pacote ficam para depois do pacman (passo 3).
pend_now=() pend_late=() req=()
for m in "${pend[@]}"; do
  pkgs=()
  [[ $m == system/* ]] && mapfile -t pkgs < <(migration_packages "$share/migrations/$m")
  if ((${#pkgs[@]})); then
    pend_late+=("$m")
    req+=("${pkgs[@]}")
  else
    pend_now+=("$m")
  fi
done
# Os apps que entraram em apps.packages desde a última vez (oferecidos antes
# do passo 2). Contam aqui para a oferta voltar mesmo quando não há mais nada a
# atualizar.
apps_seen=$root/var/lib/mk/apps-oferecidos
apps_list=$share/system/packages/apps.packages
apps_new=() apps_add=()
find_new_apps() {
  apps_new=() apps_add=()
  if [[ -s $apps_seen && -r $apps_list ]]; then
    mapfile -t apps_new < <(sed -e 's/#.*//' -e 's/[[:space:]]*$//' "$apps_list" |
      grep -v '^[[:space:]]*$' | grep -vxFf "$apps_seen" || true)
  fi
  # pacman -T devolve só os que faltam.
  if ((${#apps_new[@]})); then
    mapfile -t apps_add < <(pacman -T "${apps_new[@]}" || true)
  fi
}
find_new_apps
((${#apps_add[@]})) && printf '  apps       %s novos do Mk\n' "${#apps_add[@]}"
if ((nsys + naur > 0)); then
  jq -r '(.system + .aur)[] | "    \(.name)  \(.from) → \(.to)"' <<<"$info" | head -40
  ((nsys + naur > 40)) && note "    … e mais $((nsys + naur - 40))"
fi

[[ $mode == --check ]] && exit 0
if [[ $mode != --after-mk ]]; then
  if [[ $mk_available != true ]] && ((nsys + naur + ${#pend[@]} + ${#apps_add[@]} == 0)); then
    say "tudo em dia"
    exit 0
  fi
  ask "Atualizar agora?" || exit 0
fi
applying=1

# O que o Mk põe fora de /usr/share/mk: os comandos e o gancho do pacman. Só
# copia o que mudou. Roda na troca e de novo quando a versão nova assume
# (--after-mk): quem fez a troca foi o mk-update de antes, que só conhece a
# lista dele; um comando que a versão nova acrescentou chega na mesma rodada.
install_bins() {
  local b src dst
  for b in mk-session mk-update mk-hibernate; do
    src=$share/bin/$b dst=$root/usr/bin/$b
    [[ -f $src ]] || continue
    cmp -s "$src" "$dst" || sudo install -m755 "$src" "$dst"
  done
  src=$share/system/mk/mk-os-release.hook dst=$root/etc/pacman.d/hooks/mk-os-release.hook
  cmp -s "$src" "$dst" || sudo install -Dm644 "$src" "$dst"
}
if [[ $mode == --after-mk ]]; then install_bins; fi

# 1. O próprio Mk: baixa o canal, troca /usr/share/mk e as configs que o Mk
#    criou em ~/.config/mk (os seus ajustes.json/ajustes.lua ficam).
if [[ $mk_available == true && $mode != --after-mk ]]; then
  say "Mk"
  step=mk
  # Some em qualquer saída (finish): um clone que falha não deixa a pasta.
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/mk-update.XXXXXX")
  GIT_TERMINAL_PROMPT=0 git clone -q --depth 1 "$channel" "$tmp/mk"
  # O lançamento traz o VERSION ("commit data"); sem ele, o commit do canal.
  if [[ -s $tmp/mk/VERSION ]]; then
    version=$(head -1 "$tmp/mk/VERSION")
  else
    version="$(git -C "$tmp/mk" rev-parse --short=12 HEAD) $(git -C "$tmp/mk" log -1 --format=%cs)"
    printf '%s\n' "$version" >"$tmp/mk/VERSION"
  fi
  rm -rf "${tmp:?}/mk/.git"
  [[ -f $share/aur-pendentes.txt ]] && cp "$share/aur-pendentes.txt" "$tmp/mk/"
  sudo rm -rf "${share:?}.novo"
  sudo cp -a "$tmp/mk" "$share.novo"
  sudo rm -rf "${share:?}"
  sudo mv "$share.novo" "$share"
  install_bins
  for pair in hypr:config/hypr shell:shell/mare ghostty:config/ghostty fastfetch:config/fastfetch bash:config/bash; do
    dst=$cfg/${pair%%:*}
    if [[ -e $dst/$marker || ! -e $dst ]]; then
      # Copia ao lado e troca de uma vez: o Hyprland e o Maré vigiam esses
      # arquivos e não podem ver a pasta vazia no meio da troca.
      mkdir -p "$cfg"
      rm -rf "${dst:?}.novo" "${dst:?}.velho"
      cp -r "$share/${pair#*:}" "$dst.novo"
      touch "$dst.novo/$marker"
      [[ -e $dst ]] && mv "$dst" "$dst.velho"
      mv "$dst.novo" "$dst"
      rm -rf "${dst:?}.velho"
    else
      note "mantido (não é do Mk): $dst"
    fi
  done
  # Inteiro e de uma vez: ao lado, no disco (sync), e só então no lugar. Um
  # desligamento à força logo depois deixava o arquivo com 0 bytes, e o Mk
  # passava a se achar sem versão.
  printf '%s\n' "$version" >"$cfg/VERSION.novo"
  sync -f "$cfg/VERSION.novo" 2>/dev/null || true
  mv "$cfg/VERSION.novo" "$cfg/VERSION"
  rm -rf "${tmp:?}"
  tmp=""
  # O Maré recarrega arquivos sozinho, mas não registra arquivos novos de
  # serviço (singletons): reinicia ele inteiro, como no login.
  if [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]] && command -v qs >/dev/null; then
    # O Hyprland relê a config inteira (e limpa um aviso de erro da troca).
    hyprctl reload >/dev/null 2>&1 || true
    hyprctl dispatch "hl.dsp.exec_cmd(\"bash '$cfg/shell/scripts/mare-start' --restart\")" >/dev/null
  fi
  note "Mk em $version. O Hyprland pega a config nova no próximo login."
  # O resto (migrações, pacotes) com a versão nova do mk-update. Se a troca
  # falhar, o resumo fica como "parou em: mk".
  exec "$root/usr/bin/mk-update" --after-mk
fi

# As decisões, todas agora e em sequência, antes de qualquer passo demorado:
# a trava do pacman, os apps novos e o AUR que ficou de fora. São escolhas suas,
# ninguém responde por você; daqui para baixo nada mais pergunta. (Com Mk novo
# elas vêm logo depois da troca, não antes: a lista de apps chega com ele.)

# Um pacman interrompido (terminal fechado, queda de luz) deixa a base de
# dados travada, e tudo daqui para a frente falharia. Sem nenhum gerenciador
# de pacotes rodando, a trava é sobra: oferece tirar.
lock=$root/var/lib/pacman/db.lck
if [[ -e $lock ]] && ! pgrep -x 'pacman|yay|makepkg|pamac' >/dev/null; then
  say "o pacman ficou travado por uma atualização interrompida"
  if ask "Destravar (remove $lock)?"; then
    sudo rm -f "$lock"
  fi
fi

# Os apps que entraram em apps.packages desde a última vez. Cada um é
# oferecido uma vez só (anotado em $apps_seen, no passo 3), para não trazer de
# volta o que você tirou.
oferece_apps() {
  ((${#apps_add[@]})) || return 0
  say "apps novos do Mk"
  note "  ${apps_add[*]}"
  if ask "Instalar junto com a atualização?"; then
    # O LibreOffice é o grande (~150 MB): pergunta à parte.
    if [[ " ${apps_add[*]} " == *" libreoffice-fresh "* ]]; then
      if ! ask "Incluir o LibreOffice (~150 MB de download)?"; then
        mapfile -t apps_add < <(printf '%s\n' "${apps_add[@]}" | grep -vx libreoffice-fresh || true)
      elif grep -qs '^LANG=pt_BR' "$root/etc/locale.conf"; then
        apps_add+=(libreoffice-fresh-pt-br)
      fi
    fi
  else
    apps_add=()
  fi
}
oferece_apps

# Pacotes do AUR que não vieram no pendrive da instalação: pergunta agora,
# instala no fim (passo 4).
aur_pend=()
if [[ -s $share/aur-pendentes.txt ]] && command -v yay >/dev/null; then
  mapfile -t aur_pend <"$share/aur-pendentes.txt"
  say "AUR que ficou de fora da instalação: ${aur_pend[*]}"
  ask "Instalar no fim desta rodada?" || aur_pend=()
fi

# 2. Migrações: o que mudou no Mk fora de ~/.config/mk, cada uma uma vez.
if ((${#pend_now[@]})); then
  say "ajustes do Mk no sistema"
  step=ajustes
  for m in "${pend_now[@]}"; do
    run_migration "$m"
  done
  # Uma migração pode ter acabado de criar a lista de apps já vistos: só então
  # há o que oferecer, e a pergunta fica para cá. Se a oferta já foi feita lá
  # em cima, vale a resposta dada.
  if ((!${#apps_new[@]})); then
    find_new_apps
    oferece_apps
  fi
fi

# 3. Pacotes do Arch. Junto, na mesma transação, vão os apps novos aceitos e
#    os pacotes que as migrações pedem: instalar pacote novo sobre um sistema
#    desatualizado quebra bibliotecas.
step=sistema
# Dos pacotes que as migrações pedem, só os que faltam.
((${#req[@]})) && mapfile -t req < <(pacman -T "${req[@]}" || true)
if ((nsys > 0 || ${#apps_add[@]} || ${#req[@]})); then
  say "sistema (sudo pede a sua senha)"
  segura_sudo
  # Lista nova primeiro: é com ela que se vê o que saiu dos repositórios e o
  # que a transação vai pedir.
  sudo pacman -Sy
  if ((${#req[@]})); then
    # Tira do pedido o que saiu dos repositórios: um nome que não existe faria
    # o pacman recusar a atualização inteira, hoje e sempre.
    want=("${req[@]}") req=()
    for p in "${want[@]}"; do
      if pacman -Si "$p" &>/dev/null; then
        req+=("$p")
      else
        note "  $p não está nos repositórios: fica de fora"
      fi
    done
  fi
  alvo=(--needed "${req[@]}" "${apps_add[@]}")
  # Um ensaio antes (--print: não instala nada, não precisa de root). Com
  # --noconfirm o pacman responde o padrão a tudo, e o padrão de "qual destes
  # provedores?" é o primeiro da lista: seria escolher por você. Se o ensaio
  # mostra essa pergunta, a rodada para aqui. (LC_ALL=C: o texto procurado é o
  # do pacman em inglês.) O ensaio que falha por outro motivo não decide nada:
  # a transação de verdade dá o erro dela.
  plano=$(LC_ALL=C pacman -Su --print --noconfirm "${alvo[@]}" 2>&1 || true)
  if grep -q 'providers available for' <<<"$plano"; then
    say "o pacman precisa de uma escolha sua"
    grep -E 'providers available for|^:: Repository |^ +[0-9]+\) ' <<<"$plano" || true
    note "Mais de um pacote serve, e o Mk não escolhe por você. Rode neste terminal:"
    note "  sudo pacman -Syu ${alvo[*]}"
    note "responda ao pacman e, depois, rode mk-update de novo."
    exit 1
  fi
  # Sem perguntas. O que sobra de decisão de verdade (dois pacotes em conflito,
  # pacote que não dá para instalar) tem "não" como padrão: o pacman para sem
  # mexer em nada. Trocar um pacote pelo sucessor que o Arch declarou
  # ("Replace ...? [Y/n]") é aceito, como numa atualização feita à mão.
  sudo pacman -Su --noconfirm "${alvo[@]}" || {
    rc=$?
    say "o pacman parou"
    note "Ele rodou sem perguntar nada. Se o erro acima é um conflito entre pacotes ou"
    note "outra escolha que só você pode fazer, rode neste terminal:"
    note "  sudo pacman -Syu ${alvo[*]}"
    note "responda ao pacman e, depois, rode mk-update de novo."
    exit "$rc"
  }
fi
# Só depois de o pacman dar certo: se ele falhar, a oferta volta na próxima.
if ((${#apps_new[@]})); then
  segura_sudo
  printf '%s\n' "${apps_new[@]}" | sudo tee -a "$apps_seen" >/dev/null
fi
# As migrações que esperavam os pacotes.
if ((${#pend_late[@]})); then
  say "ajustes do Mk que dependiam dos pacotes"
  step=ajustes
  segura_sudo
  for m in "${pend_late[@]}"; do
    run_migration "$m"
  done
fi

# 4. AUR, com o yay (compila como você, sem sudo, e usa a senha só para
#    instalar: ela é pedida antes, para a compilação não acabar numa pergunta).
if ((naur > 0)) && command -v yay >/dev/null; then
  say "AUR"
  step=aur
  segura_sudo
  yay -Sua --noconfirm --answerclean None --answerdiff None
fi

# O AUR que ficou de fora da instalação, aceito lá em cima.
if ((${#aur_pend[@]})); then
  say "AUR que ficou de fora"
  step=aur
  segura_sudo
  yay -S --needed --noconfirm --answerclean None --answerdiff None --removemake "${aur_pend[@]}" &&
    sudo rm -f "$share/aur-pendentes.txt"
  # Os ganchos do limine reescrevem o menu de boot: garante que ele ainda
  # inicia sozinho.
  [[ -f $share/system/mk/boot/limine-default ]] && sudo bash "$share/system/mk/boot/limine-default" || true
fi

# Kernel novo só vale depois de reiniciar.
if [[ ! -d $root/usr/lib/modules/$(uname -r) ]]; then
  say "o kernel foi atualizado: reinicie quando puder"
else
  say "pronto"
fi
