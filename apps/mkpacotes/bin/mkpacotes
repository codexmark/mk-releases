#!/usr/bin/env bash
# Abre o MkPacotes, o gerenciador de pacotes do Mk. Se a janela já está aberta,
# só a traz para a frente.
#   mkpacotes [instalados|procurar|atualizacoes|historico]   abre direto na área
#   MKPACOTES_HOME   onde estão bin/ e qml/ (padrão: a pasta acima deste script)
set -euo pipefail
home=${MKPACOTES_HOME:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}

# Falta algo: avisa na tela (quem abriu pelo menu não vê o terminal) e sai.
missing() {
  local text="O MkPacotes precisa $1. Rode mk atualizar."
  notify-send -a MkPacotes "MkPacotes" "$text" 2>/dev/null || true
  echo "mkpacotes: $text" >&2
  exit 1
}
command -v qs >/dev/null || missing "do Quickshell"
[[ -x $home/bin/mkpacotes-coletor ]] || missing "do coletor (bin/mkpacotes-coletor)"

area=${1:-}
case $area in
  "" | instalados | procurar | atualizacoes | historico) ;;
  *)
    echo "uso: mkpacotes [instalados | procurar | atualizacoes | historico]" >&2
    exit 2
    ;;
esac

# Uma janela só: se já há uma, foca.
if qs list --all 2>/dev/null | grep -qF "Config path: $home/qml/shell.qml"; then
  addr=$(hyprctl clients -j 2>/dev/null | jq -r 'first(.[] | select(.title == "MkPacotes") | .address) // empty' 2>/dev/null || true)
  if [[ $addr =~ ^0x[0-9a-f]+$ ]]; then
    hyprctl dispatch "hl.dsp.focus({ window = \"address:$addr\" })" >/dev/null 2>&1 || true
    exit 0
  fi
fi
[[ -z $area ]] || export MKPACOTES_AREA=$area
exec qs -p "$home/qml"
