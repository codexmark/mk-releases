#!/usr/bin/env bash
# Abre o MkInstalar: instala um AppImage, um pacote do Arch ou um arquivo
# compactado, e desinstala o que ele mesmo instalou. É também o alvo de "abrir
# com" desses arquivos.
#   mkinstalar [arquivos…]   abre já nos arquivos dados
#   MKUTIL_RAIZ   onde estão bin/ e qml/ (padrão: a pasta acima deste script)
# Sem arquivo e com a janela já aberta, só a traz para a frente. Com arquivo,
# abre uma janela nova neles.
set -euo pipefail
raiz=${MKUTIL_RAIZ:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}
titulo=MkInstalar
janela=instalar

# Falta algo: avisa na tela (quem abriu pelo menu não vê o terminal) e sai.
missing() {
  local text="O $titulo precisa $1. Rode mk atualizar."
  notify-send -a "$titulo" "$titulo" "$text" 2>/dev/null || true
  echo "${0##*/}: $text" >&2
  exit 1
}
command -v qs >/dev/null || missing "do Quickshell"
command -v jq >/dev/null || missing "do jq"
[[ -x $raiz/bin/mkutil-motor ]] || missing "do motor (bin/mkutil-motor)"

# Os arquivos vão para a janela como uma lista JSON de caminhos absolutos:
# nome com espaço, aspas ou começando com "-" chega inteiro.
arquivos=()
for a in "$@"; do
  [[ $a == /* ]] || a=$PWD/$a
  arquivos+=("$a")
done

# Uma janela só: sem arquivo novo, se já há uma, foca.
if ((${#arquivos[@]} == 0)) && qs list --all 2>/dev/null | grep -qF "Config path: $raiz/qml/shell.qml"; then
  addr=$(hyprctl clients -j 2>/dev/null | jq -r --arg t "$titulo" 'first(.[] | select(.title == $t) | .address) // empty' 2>/dev/null || true)
  if [[ $addr =~ ^0x[0-9a-f]+$ ]]; then
    hyprctl dispatch "hl.dsp.focus({ window = \"address:$addr\" })" >/dev/null 2>&1 || true
    exit 0
  fi
fi

export MKUTIL_JANELA=$janela
MKUTIL_ARQUIVOS=$(jq -cn '$ARGS.positional' --args -- "${arquivos[@]}")
export MKUTIL_ARQUIVOS
exec qs -p "$raiz/qml"
