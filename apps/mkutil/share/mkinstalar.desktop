[Desktop Entry]
Type=Application
Name=MkInstalar
GenericName=Instalador de apps baixados
Comment=Instala AppImage, pacote do Arch e arquivo compactado, e desinstala depois
Exec=mkinstalar %F
Icon=mkinstalar
Terminal=false
Categories=System;Utility;
MimeType=application/vnd.appimage;application/x-iso9660-appimage;application/x-compressed-tar;application/x-xz-compressed-tar;application/x-zstd-compressed-tar;application/x-bzip-compressed-tar;application/x-bzip2-compressed-tar;application/zip;
Keywords=instalar;appimage;pacote;pkg;tar;zip;desinstalar;aplicativos;
