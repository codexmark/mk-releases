#!/usr/bin/env bash
# Inicia o Maré no tamanho escolhido nos Ajustes (Tela > Tamanho da interface).
# O tamanho vale para tudo de uma vez (ilha, painéis, ajustes, bloqueio) pela
# escala do Qt, com o texto desenhado no tamanho final, sem borrar.
#
#   mare-start              inicia (o autostart do Hyprland chama assim)
#   mare-start --restart    fecha o Maré que está rodando e inicia de novo
set -uo pipefail

shell=$(cd "$(dirname "$0")/.." && pwd)
root=$(dirname "$shell")
log=${XDG_CACHE_HOME:-$HOME/.cache}/mk
mkdir -p "$log"

scale=$(jq -r '."ui.scale" // empty' "$root/ajustes.json" 2>/dev/null)
# Só número, e maior que zero: "0" e "0.0" não têm nenhum dígito de 1 a 9.
[[ $scale =~ ^[0-9]+(\.[0-9]+)?$ && $scale == *[1-9]* ]] || scale=0.85

if [[ ${1:-} == --restart ]]; then
  qs kill -p "$shell" >/dev/null 2>&1
  sleep 0.4
  # Quando as camadas do Maré renascem, a janela em uso fica sem o teclado
  # até um clique (visto no meio do mk-update, na hora da senha): devolve.
  (
    for wait in 1.5 2; do
      sleep "$wait"
      win=$(hyprctl activewindow -j 2>/dev/null | jq -r '.address // empty')
      # O endereço entra numa expressão Lua: só hexadecimal, do início ao fim.
      [[ $win =~ ^0x[0-9a-f]+$ ]] && hyprctl dispatch "hl.dsp.focus({ window = \"address:$win\" })" >/dev/null 2>&1
    done
  ) &
fi
QT_SCALE_FACTOR=$scale exec qs -p "$shell" >"$log/mare.log" 2>&1
