#!/usr/bin/env bash
# Gera o QR code para entrar no Wi-Fi atual (o formato que a câmera do
# celular entende) e imprime o nome da rede.
# Uso: mare-wifi-qr <arquivo.png>
# O PNG contém a senha: o Maré o grava em $XDG_RUNTIME_DIR (só do usuário,
# apagado ao desligar) e o remove quando o painel fecha.
# Só lê /sys para saber se a interface é Wi-Fi. SYS troca a raiz, para testar.
set -euo pipefail

sys=${SYS:-/sys}

out=${1:?uso: mare-wifi-qr <arquivo.png>}
# Sem rota o `ip` sai com 2; o "|| true" deixa o aviso abaixo falar.
dev=$(ip route get 1.1.1.1 2>/dev/null | awk '{ for (i = 1; i <= NF; i++) if ($i == "dev") { print $(i + 1); exit } }') || true
[[ -n $dev && -d $sys/class/net/$dev/wireless ]] || { echo "não está num Wi-Fi" >&2; exit 1; }
# "-e no": o -g escapa ":" e "\" (uma rede "Casa: 5G" viria "Casa\: 5G"), e
# aqui o valor é usado inteiro, como nome da conexão, SSID e senha.
conn=$(nmcli -e no -g GENERAL.CONNECTION dev show "$dev")
ssid=$(nmcli -e no -g 802-11-wireless.ssid con show "$conn")
# Daqui em diante o campo pode não existir (a rede aberta não tem a seção de
# segurança): vazio no lugar de erro. O -s é o que mostra um segredo.
campo() { nmcli -e no -g "$1" con show "$conn" 2>/dev/null || true; }
segredo() { nmcli -s -e no -g "$1" con show "$conn" 2>/dev/null || true; }

[[ -n $ssid ]] || { echo "conexão sem nome de rede" >&2; exit 1; }
keymgmt=$(campo 802-11-wireless-security.key-mgmt)
hidden=$(campo 802-11-wireless.hidden)

# Caracteres especiais do formato WIFI: precisam de barra antes.
escape() { sed -e 's/[\;,:"]/\\&/g' <<<"$1"; }

# O key-mgmt do NetworkManager:
#   (vazio)        sem a seção de segurança: rede aberta
#   owe            aberta para quem entra, cifrada no ar: também sem senha
#   none           WEP (não é "sem segurança"): a chave é a wep-key<índice>
#   wpa-psk, sae   WPA2 e WPA3 pessoal: os dois são T:WPA no QR
#   wpa-eap..., ieee8021x   802.1X: usuário e senha de cada um, sem QR
case $keymgmt in
  "" | owe) tipo=nopass senha="" ;;
  none)
    idx=$(campo 802-11-wireless-security.wep-tx-keyidx)
    [[ $idx == [0-3] ]] || idx=0
    tipo=WEP senha=$(segredo "802-11-wireless-security.wep-key$idx")
    ;;
  wpa-eap* | ieee8021x)
    echo "rede corporativa (802.1X): cada pessoa tem o seu usuário, não há QR" >&2
    exit 1
    ;;
  *) tipo=WPA senha=$(segredo 802-11-wireless-security.psk) ;;
esac

payload="WIFI:T:$tipo;S:$(escape "$ssid");"
if [[ $tipo != nopass ]]; then
  [[ -n $senha ]] || { echo "sem acesso à senha desta rede" >&2; exit 1; }
  payload+="P:$(escape "$senha");"
fi
# Rede oculta: sem isto o celular procura o nome, não acha e desiste.
[[ $hidden == yes ]] && payload+="H:true;"
payload+=";"

umask 077
qrencode -t PNG -m 2 -s 8 --foreground=cdc4ba --background=141211 -o "$out" "$payload"
# printf: o echo engoliria uma rede chamada "-n".
printf '%s\n' "$ssid"
