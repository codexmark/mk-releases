#!/usr/bin/env bash
# Captura de tela do Mk. Salva em <Imagens>/Capturas, copia para a área de
# transferência e avisa.
#   mare-shot copiar    escolhe uma área e só copia
#   mare-shot area      escolhe uma área e salva
#   mare-shot janela    a janela em foco
#   mare-shot tela      a tela inteira
#   mare-shot pasta     imprime a pasta das capturas
#   mare-shot gravacao  imprime por que não dá para gravar (nada = dá)
set -euo pipefail

pics=$(xdg-user-dir PICTURES 2>/dev/null || true)
[[ -n $pics && $pics != "$HOME" ]] || pics=$HOME/Pictures
dir=$pics/Capturas
[[ ${1:-} == pasta ]] && { echo "$dir"; exit 0; }

# Só lê a ajuda do gpu-screen-recorder; não grava nada.
if [[ ${1:-} == gravacao ]]; then
  command -v gpu-screen-recorder >/dev/null || { echo "falta o gpu-screen-recorder"; exit 0; }
  rc=0
  ajuda=$(timeout 3 gpu-screen-recorder --help 2>&1) || rc=$?
  if ((rc == 124 || rc == 137)); then
    echo "o gpu-screen-recorder não respondeu"
  elif [[ $ajuda != *usage:* ]]; then
    echo "o gpu-screen-recorder não abre neste sistema"
  fi
  exit 0
fi

# O subcomando é conferido antes de qualquer coisa ser criada: um engano de
# digitação só mostra o uso.
modo=${1:-area}
case $modo in
  copiar | area | janela | tela) ;;
  *)
    echo "uso: mare-shot copiar | area | janela | tela | pasta | gravacao" >&2
    exit 2 ;;
esac

# A área da captura ("x,y LxA", como o grim pede). Vazia = a tela inteira.
geo=""
case $modo in
  copiar | area)
    geo=$(slurp -b 0b0b0b66 -c ce5e32 -w 1) || exit 0 ;;
  janela)
    # O hyprctl falhando, uma resposta que não é JSON ou uma janela sem
    # posição e tamanho em números dão no mesmo: não há o que capturar.
    geo=$(hyprctl -j activewindow 2>/dev/null | jq -r '
      try (
        [.at[0], .at[1], .size[0], .size[1]]
        | select(all(.[]; type == "number")) | map(floor)
        | select(.[2] > 0 and .[3] > 0)
        | "\(.[0]),\(.[1]) \(.[2])x\(.[3])"
      ) catch empty' 2>/dev/null) || geo=""
    [[ -n $geo ]] || { notify-send -a Mk "Sem janela em foco" "Nada foi capturado."; exit 1; } ;;
esac

if [[ $modo == copiar ]]; then
  grim -g "$geo" - | wl-copy --type image/png
  notify-send -a Mk "Captura copiada" "A área está na área de transferência."
  exit 0
fi

# A pasta só nasce quando há o que salvar (depois do Esc e do "sem janela").
mkdir -p "$dir"
file=$dir/$(date +%F_%H-%M-%S).png
if [[ -n $geo ]]; then grim -g "$geo" "$file"; else grim "$file"; fi
# A captura já está salva: se a cópia falhar, o aviso sai do mesmo jeito e o
# erro do wl-copy vira a saída do script.
rc=0
wl-copy --type image/png <"$file" || rc=$?
notify-send -a Mk -i "$file" "Captura salva" "${file/#$HOME/\~}"
exit "$rc"
