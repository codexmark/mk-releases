#!/usr/bin/env bash
# O espectro do som que está tocando, para a ilha ondular com a música.
# Roda o cava e imprime uma linha por quadro: "12;40;7;...;" (0 a 100, dos
# graves aos agudos).
#   mare-cava [faixas]
# Faixas que não são um número inteiro caem no padrão (28).
# MARE_CAVA_SOURCE escolhe de onde ouvir (padrão: o que sai nos alto-falantes).
set -euo pipefail

command -v cava >/dev/null || exit 127
conf=${XDG_RUNTIME_DIR:-/tmp}/mare-cava.conf
# O valor entra no arquivo do cava: só número, para não virar outras linhas.
bars=${1:-28}
[[ $bars =~ ^[0-9]+$ ]] || bars=28
cat >"$conf" <<EOF2
[general]
bars = $bars
framerate = 30
autosens = 1
lower_cutoff_freq = 50
higher_cutoff_freq = 9000

[input]
method = pipewire
source = ${MARE_CAVA_SOURCE:-auto}

[output]
method = raw
raw_target = /dev/stdout
data_format = ascii
ascii_max_range = 100
bar_delimiter = 59
frame_delimiter = 10
channels = mono

[smoothing]
noise_reduction = 55
EOF2
# Um cava de um Maré anterior (que reiniciou ou caiu) não pode ficar para trás.
pkill -f "cava -p $conf" 2>/dev/null || true
# --pdeathsig: se o Maré morrer, o cava morre junto.
exec setpriv --pdeathsig TERM cava -p "$conf"
