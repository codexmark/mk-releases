#!/usr/bin/env bash
# Detalhes da máquina para a página "Sobre o Mk" dos Ajustes, em JSON.
set -uo pipefail

host=$(cat /etc/hostname 2>/dev/null || uname -n)
kernel=$(uname -r)
cpu=$(awk -F': ' '/model name/ { print $2; exit }' /proc/cpuinfo | sed -e 's/([^)]*)//g' -e 's/  */ /g')
mem=$(awk '/MemTotal/ { printf "%.1f GiB", $2 / 1048576 }' /proc/meminfo | tr . ,)
up=$(uptime -p 2>/dev/null | sed -e 's/^up //' -e 's/days\?/d/; s/hours\?/h/; s/minutes\?/min/' -e 's/,//g')
hypr=$(hyprctl version -j 2>/dev/null | jq -r '.version // .tag // empty' 2>/dev/null)
qs=$(qs --version 2>/dev/null | head -1 | awk '{ print $2 }')

jq -nc --arg host "$host" --arg kernel "$kernel" --arg cpu "$cpu" --arg mem "$mem" \
  --arg uptime "$up" --arg hyprland "$hypr" --arg quickshell "$qs" \
  '{host: $host, kernel: $kernel, cpu: $cpu, mem: $mem, uptime: $uptime, hyprland: $hyprland, quickshell: $quickshell}'
